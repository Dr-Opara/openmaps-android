<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shown by the OS while the process starts (Android 12+ system splash,
         backported by androidx.core:core-splashscreen). Swapped for
         Theme.OpenMaps by installSplashScreen() in MainActivity. -->
    <style name="Theme.OpenMaps.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/openmaps_navy_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenMaps</item>
    </style>

    <!-- The app is dark-only: the map is always the backdrop for dark glass controls. -->
    <style name="Theme.OpenMaps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/openmaps_navy_900</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
