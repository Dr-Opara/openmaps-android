<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Phase 5: rear-camera preview for Live. Requested at runtime, only when Live is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- GPS is preferred but not required: the map is fully usable without a fix. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
      Camera is likewise optional: without it the map, search, routing and turn-by-turn all still
      work, and Live degrades to an explanation. Marking it required would hide OpenMaps from
      devices with no camera at all (including some tablets), which is not what we want yet.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      AR features are all OPTIONAL. OpenMaps must install and run on devices without AR: Live falls
      back to the CameraX preview, and map/search/routing/navigation are unaffected. `camera.any`
      is declared as required="false" above for the same reason.
    -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!-- AR VPS/Earth tracking needs hardware-accelerated OpenGL ES 3.0+. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <!--
      Delta-spec section 14 (voice guidance): package-visibility declaration for API 30+. Without
      this, `android.speech.tts.TextToSpeech`'s internal engine-discovery query can come back empty
      on some OS versions even when a TTS engine is genuinely installed, which would silently
      disable voice with no exception to diagnose — the exact "works on the device but the app
      can't see it" failure mode this phase already found once for ARCore (see ARCHITECTURE.md's
      "AR stuck at Idle"), so it is declared proactively here rather than waiting to rediscover it.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".OpenMapsApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMaps.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ARCore (Phase 6). `optional="true"` is the important part: it tells the Play Store the
          app installs and runs on devices without ARCore, which is what we want because Live falls
          back to the CameraX preview when Geospatial is unavailable. `value="optional"` combined
          with the com.google.ar.core marker is the documented way to declare ARCore support.
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!--
          ARCore Geospatial authorization (the blocker behind "AR arrows never appear").

          `com.google.android.ar.API_KEY` is the exact meta-data name Google documents for
          Geospatial/Cloud Anchors on Android; the session itself reads it, which is why
          ARCore 1.56's `Session` has no API-key constructor. With no valid key here, the
          session still starts but `Earth` reports ERROR_NOT_AUTHORIZED, so Earth never tracks
          and no anchor is ever created.

          The value is injected from `ARCORE_API_KEY` (see app/build.gradle.kts) so the
          key never enters version control. With nothing configured it resolves to an empty
          string, which behaves exactly like the key being absent: Live falls back to CameraX.

          Note there is deliberately no `com.google.android.geo.API_KEY` entry here: that key
          belongs to the Google Maps SDK, and OpenMaps renders with MapLibre, so it is not needed.
        -->
        <meta-data
            android:name="com.google.android.ar.API_KEY"
            android:value="${ARCORE_API_KEY}" />

        <service
            android:name=".service.NavigationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
