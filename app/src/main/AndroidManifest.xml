<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Phase 5: rear-camera preview for Live. Requested at runtime, only when Live is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- GPS is preferred but not required: the map is fully usable without a fix. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
      Camera is likewise optional: without it the map, search, routing and turn-by-turn all still
      work, and Live degrades to an explanation. Marking it required would hide OpenMaps from
      devices with no camera at all (including some tablets), which is not what we want yet.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      AR features are all OPTIONAL. OpenMaps must install and run on devices without AR: Live falls
      back to the CameraX preview, and map/search/routing/navigation are unaffected. `camera.any`
      is declared as required="false" above for the same reason.
    -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <!-- AR VPS/Earth tracking needs hardware-accelerated OpenGL ES 3.0+. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:name=".OpenMapsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMaps.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ARCore (Phase 6). `optional="true"` is the important part: it tells the Play Store the
          app installs and runs on devices without ARCore, which is what we want because Live falls
          back to the CameraX preview when Geospatial is unavailable. `value="optional"` combined
          with the com.google.ar.core marker is the documented way to declare ARCore support.
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>

</manifest>
